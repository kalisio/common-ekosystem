{
  "name": "@kalisio/common-geospatial",
  "description": "Geospatial utilities for the Kalisio ekosystem",
  "version": "0.11.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./foundation": {
      "development": "./src/foundation/index.js",
      "import": "./dist/foundation/index.mjs",
      "require": "./dist/foundation/index.cjs"
    },
    "./operators": {
      "development": "./src/operators/index.js",
      "import": "./dist/operators/index.mjs",
      "require": "./dist/operators/index.cjs"
    },
    "./io": {
      "development": "./src/io/index.js",
      "import": "./dist/io/index.mjs",
      "require": "./dist/io/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "geospatial",
    "coordinates",
    "geometry",
    "feature",
    "geojson",
    "processing",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-geospatial"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/master/packages/common-geospatial",
  "peerDependencies": {
    "@kalisio/common-core": "workspace:*",
    "@tmcw/togeojson": "catalog:",
    "@turf/buffer": "catalog:",
    "@turf/convex": "catalog:",
    "@turf/helpers": "catalog:",
    "@turf/meta": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "heap-js": "catalog:",
    "proj4": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tmcw/togeojson": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tmcw/togeojson": "catalog:",
    "chroma-js": "catalog:",
    "mongodb": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./foundation": {
        "import": "./dist/foundation/index.mjs",
        "require": "./dist/foundation/index.cjs"
      },
      "./operators": {
        "import": "./dist/operators/index.mjs",
        "require": "./dist/operators/index.cjs"
      },
      "./io": {
        "import": "./dist/io/index.mjs",
        "require": "./dist/io/index.cjs"
      }
    }
  }
}
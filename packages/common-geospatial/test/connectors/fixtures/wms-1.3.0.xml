<?xml version="1.0" encoding="UTF-8"?>
<WMS_Capabilities version="1.3.0"
  xmlns="http://www.opengis.net/wms"
  xmlns:xlink="http://www.w3.org/1999/xlink">
  <Service>
    <Name>WMS</Name>
    <Title>Demo WMS</Title>
  </Service>
  <Capability>
    <Request>
      <GetMap>
        <Format>image/png</Format>
        <DCPType>
          <HTTP>
            <Get>
              <OnlineResource xlink:href="https://alt.example.com/wms?"/>
            </Get>
          </HTTP>
        </DCPType>
      </GetMap>
    </Request>
    <Layer>
      <Title>Root group</Title>
      <CRS>EPSG:4326</CRS>
      <CRS>EPSG:3857</CRS>
      <EX_GeographicBoundingBox>
        <westBoundLongitude>-10</westBoundLongitude>
        <eastBoundLongitude>10</eastBoundLongitude>
        <southBoundLatitude>40</southBoundLatitude>
        <northBoundLatitude>55</northBoundLatitude>
      </EX_GeographicBoundingBox>
      <Layer>
        <Name>roads</Name>
        <Title>Roads</Title>
        <Abstract>Road network</Abstract>
        <CRS>EPSG:2154</CRS>
        <EX_GeographicBoundingBox>
          <westBoundLongitude>-5</westBoundLongitude>
          <eastBoundLongitude>8</eastBoundLongitude>
          <southBoundLatitude>42</southBoundLatitude>
          <northBoundLatitude>51</northBoundLatitude>
        </EX_GeographicBoundingBox>
        <Style>
          <Name>default</Name>
          <Title>Default style</Title>
          <LegendURL>
            <Format>image/png</Format>
            <OnlineResource xlink:href="https://example.com/legend/roads.png"/>
          </LegendURL>
        </Style>
        <Dimension name="time" units="ISO8601" default="2020-01-01">2020-01-01/2020-12-31/P1M</Dimension>
      </Layer>
      <Layer>
        <Name>zones</Name>
        <Title>Zones</Title>
        <BoundingBox CRS="EPSG:2154" minx="600000" miny="6600000" maxx="700000" maxy="6700000"/>
      </Layer>
      <Layer>
        <Name>rivers</Name>
        <Title>Rivers</Title>
      </Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>

{
  "name": "@kalisio/geokit",
  "description": "Lightweight geospatial utility library",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "geokit",
    "coordinates",
    "geometry",
    "feature",
    "geojson",
    "processing",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/geokit"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://kalisio.github.io/common-ekosystem/packages/geokit",
  "dependencies": {
    "@kalisio/check": "workspace:*",
    "@logtape/logtape": "catalog:",
    "proj4": "catalog:"
  }
}
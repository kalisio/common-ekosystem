{
  "name": "@kalisio/common-time",
  "description": "Time utilities for the Kalisio ekosystem",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "describe",
      "it",
      "test",
      "expect",
      "beforeAll",
      "afterAll",
      "beforeEach",
      "afterEach",
      "vi"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "common-time"
  ],
  "author": {
    "name": "KALISIO",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-time"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/main/packages/common-time",
  "dependencies": {
    "moment": "catalog:",
    "moment-timezone": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/common-core": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }

{
  "name": "@kalisio/kompare",
  "description": "Object and file comparison utilities",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "kompare",
    "file",
    "xml",
    "yaml",
    "json",
    "object",
    "comparison",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/kompare"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://kalisio.github.io/common-ekosystem/packages/kompare",
  "dependencies": {
    "@kalisio/check": "workspace:",
    "fast-xml-parser": "catalog:",
    "lodash": "catalog:",
    "yaml": "catalog:"
  }
}
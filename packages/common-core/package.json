{
  "name": "@kalisio/common-core",
  "description": "Core utilities for the Kalisio ekosystem",
  "version": "0.9.0",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./predicates": {
      "development": "./src/predicates/index.js",
      "import": "./dist/predicates/index.mjs",
      "require": "./dist/predicates/index.cjs"
    },
    "./utilities": {
      "development": "./src/utilities/index.js",
      "import": "./dist/utilities/index.mjs",
      "require": "./dist/utilities/index.cjs"
    },
    "./io": {
      "development": "./src/io/index.js",
      "import": "./dist/io/index.mjs",
      "require": "./dist/io/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "self",
      "WorkerGlobalScope",
      "ServiceWorkerGlobalScope",
      "DOMParser"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-core"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/master/packages/common-core",
  "peerDependencies": {
    "@xmldom/xmldom": "catalog:",
    "lodash-es": "catalog:",
    "mathjs": "catalog:",
    "moment": "catalog:",
    "papaparse": "catalog:",
    "sanitize-html": "catalog:",
    "sift": "catalog:"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": { "optional": true },
    "lodash-es": { "optional": true },
    "mathjs": { "optional": true },
    "moment": { "optional": true },
    "papaparse": { "optional": true },
    "sanitize-html": { "optional": true },
    "sift": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./predicates": {
        "import": "./dist/predicates/index.mjs",
        "require": "./dist/predicates/index.cjs"
      },
      "./utilities": {
        "import": "./dist/utilities/index.mjs",
        "require": "./dist/utilities/index.cjs"
      },
      "./io": {
        "import": "./dist/io/index.mjs",
        "require": "./dist/io/index.cjs"
      }
    }
  }
}
{
  "name": "@kalisio/common-graphics",
  "description": "Graphics utilities for the Kalisio ekosystem",
  "version": "0.1.2",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "Image"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "graphics",
    "SVG",
    "shape",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-graphics"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/master/packages/common-graphikcs",
  "dependencies": {
    "@kalisio/common-core": "workspace:*",
    "@logtape/logtape": "catalog:"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "happy-dom": "catalog:"
  }
}

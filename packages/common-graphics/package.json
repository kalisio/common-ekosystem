{
  "name": "@kalisio/common-graphics",
  "description": "Graphics utilities for the Kalisio ekosystem",
  "version": "0.4.2",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "Image",
      "createImageBitmap",
      "OffscreenCanvas"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "graphics",
    "SVG",
    "shape",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-graphics"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/master/packages/common-graphikcs",
  "dependencies": {},
  "peerDependencies": {
    "@kalisio/common-core": "workspace:*",
    "@logtape/logtape": "catalog:",
    "chroma-js": "catalog:",
    "lru-cache": "catalog:",
    "sharp": "catalog:"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    }
  }
}

{
  "name": "@kalisio/common-graphics",
  "description": "Graphics utilities for the Kalisio ekosystem",
  "version": "0.11.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "development": {
        "browser": "./src/index.browser.js",
        "default": "./src/index.node.js"
      },
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.node.mjs",
      "require": "./dist/index.node.cjs"
    },
    "./utilities": {
      "development": {
        "browser": "./src/utilities/index.browser.js",
        "default": "./src/utilities/index.node.js"
      },
      "browser": "./dist/utilities/index.browser.mjs",
      "import": "./dist/utilities/index.node.mjs",
      "require": "./dist/utilities/index.node.cjs"
    },
    "./shapes": {
      "development": "./src/shapes/index.js",
      "import": "./dist/shapes/index.mjs",
      "require": "./dist/shapes/index.cjs"
    }
  },
  "imports": {
    "#utilities": {
      "development": {
        "browser": "./src/utilities/index.browser.js",
        "default": "./src/utilities/index.node.js"
      },
      "browser": "./dist/utilities/index.browser.mjs",
      "import": "./dist/utilities/index.node.mjs",
      "require": "./dist/utilities/index.node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "Image",
      "createImageBitmap",
      "OffscreenCanvas"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "publint",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "graphics",
    "SVG",
    "shape",
    "kalisio"
  ],
  "author": {
    "name": "Kalisio",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/common-graphics"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem/tree/master/packages/common-graphics",
  "peerDependencies": {
    "@kalisio/common-core": "workspace:*",
    "@logtape/logtape": "catalog:",
    "chroma-js": "catalog:",
    "lru-cache": "catalog:",
    "sharp": "catalog:"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "pixelmatch": "catalog:",
    "pngjs": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "browser": "./dist/index.browser.mjs",
        "import": "./dist/index.node.mjs",
        "require": "./dist/index.node.cjs"
      },
      "./utilities": {
        "browser": "./dist/utilities/index.browser.mjs",
        "import": "./dist/utilities/index.node.mjs",
        "require": "./dist/utilities/index.node.cjs"
      },
      "./shapes": {
        "import": "./dist/shapes/index.mjs",
        "require": "./dist/shapes/index.cjs"
      }
    },
    "imports": {
      "#utilities": {
        "browser": "./dist/utilities/index.browser.mjs",
        "import": "./dist/utilities/index.node.mjs",
        "require": "./dist/utilities/index.node.cjs"
      }
    }
  }
}

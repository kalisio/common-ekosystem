{
  "name": "@kalisio/graphiks",
  "description": "A minimal parametric shape factory for SVG graphics",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "standard": {
    "globals": [
      "Image"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "scripts": {
    "build": "vite build",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "graphics",
    "SVG",
    "shape",
    "basik"
  ],
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git",
    "directory": "packages/graphiks"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://kalisio.github.io/common-ekosystem/packages/graphiks",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kalisio/kore": "workspace:*",
    "@logtape/logtape": "catalog:"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "happy-dom": "catalog:"
  }
}

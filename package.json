{
  "name": "common-ekosystem",
  "description": "A common base of small, reusable utility libraries for the Kalisio ecosystem",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:common-core": "pnpm --filter @kalisio/common-core build",
    "build:common-geospatial": "pnpm --filter @kalisio/common-geospatial build",
    "build:common-graphics": "pnpm --filter @kalisio/common-graphics build",
    "prebump": "changeset",
    "bump": "changeset version",
    "clear": "pnpm -r exec rimraf node_modules dist coverage",
    "docs:prepare": "pnpm --filter './examples/*' build",
    "docs:dev": "pnpm docs:prepare && pnpm --filter docs run dev",
    "docs:build": "pnpm docs:prepare && pnpm --filter docs run build",
    "inspect": "knip || true",
    "lint": "pnpm -r lint",
    "lint:common-core": "pnpm --filter @kalisio/common-core lint",
    "lint:common-geospatial": "pnpm --filter @kalisio/common-geospatial lint",
    "lint:common-graphics": "pnpm --filter @kalisio/common-graphics lint",
    "prepare": "husky",
    "prerelease": "pnpm build",
    "release": "changeset publish",
    "postrelease": "git push --follow-tags",
    "pretest": "mkdir -p coverage",
    "test": "pnpm -r test",
    "posttest": "pnpm lcov-result-merger --prepend-source-files 'packages/*/coverage/lcov.info' coverage/lcov.info",
    "test:common-core": "pnpm --filter @kalisio/common-core test",
    "test:common-geospatial": "pnpm --filter @kalisio/common-geospatial test",
    "test:common-graphics": "pnpm --filter @kalisio/common-graphics test"
  },
  "keywords": [
    "kalisio",
    "ekosystem",
    "common-core",
    "common-graphics",
    "common-geospatial"
  ],
  "author": {
    "name": "KALISIO",
    "email": "contact@kalisio.com",
    "url": "https://github.com/kalisio",
    "logo": "https://kalisio.github.io/kalisioscope/kalisio/kalisio-logo-light.svg"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalisio/common-ekosystem.git"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "https://github.com/kalisio/common-ekosystem#readme",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lcov-result-merger": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "standard": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  },
  "metaCatalog": {
    "version": "0.10.0",
    "syncedAt": "2026-09-01T12:19:49.636Z"
  }
}
{
  "name": "common-ekosystem",
  "description": "A common base of small, reusable utility libraries for the Kalisio ecosystem",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:check": "pnpm --filter @kalisio/check build",
    "build:geokit": "pnpm --filter @kalisio/geokit build",
    "build:graphiks": "pnpm --filter @kalisio/graphiks build",
    "build:kompare": "pnpm --filter @kalisio/kompare build",
    "changeset": "changeset",
    "changeset:release": "pnpm build && changeset publish",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm --filter @kalisio/check lint",
    "lint:geokit": "pnpm --filter @kalisio/geokit lint",
    "lint:graphiks": "pnpm --filter @kalisio/graphiks lint",
    "lint:kompare": "pnpm --filter @kalisio/kompare lint",
    "prepare": "husky",
    "pretest": "mkdir -p coverage",
    "test": "pnpm -r test --coverage",
    "posttest": "pnpm lcov-result-merger --prepend-source-files 'packages/*/coverage/lcov.info' coverage/lcov.info",
    "test:check": "pnpm --filter @kalisio/check test --coverage",
    "test:geokit": "pnpm --filter @kalisio/geokit test --coverage",
    "test:graphiks": "pnpm --filter @kalisio/graphiks test --coverage",
    "test:kompare": "pnpm --filter @kalisio/kompare test --coverage"
  },
  "keywords": [
    "check",
    "graphiks",
    "geokit",
    "ekosystem",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "git://github.com/kalisio/common-ekosystem#readme",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "husky": "catalog:",
    "keycloak-js": "catalog:",
    "lcov-result-merger": "catalog:",
    "lint-staged": "catalog:",
    "lodash": "catalog:",
    "mermaid": "catalog:",
    "moment": "catalog:",
    "quasar": "catalog:",
    "standard": "catalog:",
    "vite": "catalog:",
    "vite-bundle-visualizer": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-mermaid": "catalog:",
    "vitepress-theme-kalisio": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {}
  },
  "metaCatalog": "0.7.0"
}
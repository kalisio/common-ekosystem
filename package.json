{
  "name": "common-ekosystem",
  "packageManager": "pnpm@10.1.0",
  "type": "module",
  "standard": {
    "globals": [
      "describe",
      "it",
      "expect",
      "beforeEach",
      "afterEach",
      "Image"
    ],
    "ignore": [
      "dist/**"
    ]
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "pnpm lint"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "lint": "standard 'packages/**/*.js' --fix",
    "lint:check": "pnpm run lint -- 'packages/check/**/*.js'",
    "lint:geokit": "pnpm run lint -- 'packages/geokit/**/*.js'",
    "lint:graphiks": "pnpm run lint -- 'packages/graphiks/**/*.js'",
    "test": "vitest run --coverage",
    "test:check": "pnpm run test --project check",
    "test:geokit": "pnpm run test --project geokit",
    "test:graphiks": "pnpm run test --project graphiks",
    "build": "pnpm run build:check && pnpm run build:geokit && pnpm run build:graphiks",
    "build:check": "pnpm --filter @kalisio/check build",
    "build:geokit": "pnpm --filter @kalisio/geokit build",
    "build:graphiks": "pnpm --filter @kalisio/graphiks build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm build && changeset publish",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "check",
    "graphiks",
    "geokit",
    "ekosystem",
    "kalisio"
  ],
  "author": {
    "name": "KALISIO <contact@kalisio.com>",
    "url": "https://github.com/kalisio"
  },
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/common-ekosystem.git"
  },
  "bugs": {
    "url": "https://github.com/kalisio/common-ekosystem/issues"
  },
  "homepage": "git://github.com/kalisio/common-ekosystem#readme",
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@kalisio/meta-ekosystem": "^0.2.1",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "husky": "catalog:",
    "keycloak-js": "catalog:",
    "lint-staged": "catalog:",
    "lodash": "catalog:",
    "mermaid": "catalog:",
    "moment": "catalog:",
    "quasar": "catalog:",
    "standard": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-mermaid": "catalog:",
    "vitepress-theme-kalisio": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {},
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}